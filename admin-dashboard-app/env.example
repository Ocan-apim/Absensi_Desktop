# Copy to admin-dashboard-app/.env.local when needed.

# Optional: override API base. Leave unset when the static app is served from the same
# origin as admin_stats_api.php (e.g. both under http://absensi.test/) — the app uses
# window.location.origin automatically.
# NEXT_PUBLIC_PHP_API_BASE=http://absensi.test

# Optional: admin username when not using the embedded iframe (e.g. next dev on :3000).
# NEXT_PUBLIC_ADMIN_STATS_USERNAME=your_admin_username
